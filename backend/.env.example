# ========================================
# Variables de Entorno - Backend (EJEMPLO)
# ========================================
# Copia este archivo como .env y configura tus valores reales
# NUNCA subas el archivo .env a Git

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://tu-host.neon.tech/tu-database?sslmode=require
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña_secreta

# JWT Secret Key (genera una clave segura de al menos 256 bits)
JWT_SECRET=tu_clave_secreta_muy_larga_de_al_menos_256_bits_para_firmar_tokens_jwt
JWT_EXPIRATION=86400000

# Server
SERVER_PORT=8080
